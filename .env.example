# ---------------------------------------------------------------- runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# SQLite file (created on first boot). Migrations run automatically at startup.
SQLITE_PATH=./data/simulated-trading.sqlite

# ---------------------------------------------------------------- auth
# REQUIRED in production (>= 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=change-me-please-this-is-a-dev-only-secret-key
SESSION_TTL_SEC=43200
COOKIE_NAME=sim_session
COOKIE_SECURE=false
TRUST_PROXY=false

# Public base URL, used to build verification / reset links
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- initial admin (seed)
ADMIN_EMAIL=admin@simtrade.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-demo-123

# ---------------------------------------------------------------- dev helpers
# Print verification/reset links to the server console and expose /api/v1/auth/dev/link
DEV_EMAIL_LINKS=true
EXPOSE_DEV_TOKENS=true
# Require email verification before trading (default false so the demo works instantly)
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------- trading defaults
PAYOUT_RATE=0.85
PAYOUT_MODE=profit

# ---------------------------------------------------------------- realtime
WS_TICK_MAX_PER_SEC=15
WS_HEARTBEAT_MS=30000
WS_MAX_SUBSCRIPTIONS=30
WS_MAX_CONNECTIONS=2000

# ---------------------------------------------------------------- uploads & backups
UPLOADS_DIR=./data/uploads
BACKUP_DIR=./data/backups
MAX_UPLOAD_BYTES=524288
BACKUP_INTERVAL_MS=21600000

# ---------------------------------------------------------------- csrf & 2FA
CSRF_HEADER=x-csrf-token
CSRF_COOKIE=sim_csrf
TOTP_ISSUER=SimTrade Demo
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MIN_MS=900000

# ---------------------------------------------------------------- retention & loops
TICK_RETENTION_DAYS=7
CANDLE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=90
TICKS_FLUSH_MS=1000
SETTLE_INTERVAL_MS=250
TEST_SETTLE_INTERVAL_MS=100
HOUSEKEEPING_INTERVAL_MS=600000

# ---------------------------------------------------------------- password hashing
# Keep these in sync with the hashes you already store: changing them only
# affects *new* hashes (old ones still verify).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---------------------------------------------------------------- rate limits
RATE_AUTH_MAX=20
RATE_AUTH_WINDOW_MS=60000
RATE_TRADE_MAX=30
RATE_TRADE_WINDOW_MS=60000
RATE_GLOBAL_MAX=1200
RATE_GLOBAL_WINDOW_MS=60000
