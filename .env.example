# ---------------------------------------------------------------------------
# Demo trading backend - example environment
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- persistence -----------------------------------------------------------
# sqlite (development) | postgres (production)
DB_DRIVER=sqlite
SQLITE_PATH=./data/demo.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/trading

# --- auth ------------------------------------------------------------------
# Required in production, min 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-32-characters-min
JWT_TTL_SEC=43200
# Optional: creates/promotes this account on boot (role=admin)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-admin-password

# --- http / security -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
RATE_GLOBAL_MAX=600
RATE_GLOBAL_WINDOW_MS=60000
RATE_AUTH_MAX=20
RATE_AUTH_WINDOW_MS=60000
RATE_TRADE_MAX=10
RATE_TRADE_WINDOW_MS=60000

# --- trading economy (business decisions, see README) ---------------------
CURRENCY=USD
INITIAL_BALANCE_CENTS=1000000
TRADE_MIN_CENTS=100
TRADE_MAX_CENTS=100000
PAYOUT_RATE=0.85
PAYOUT_MODE=profit
ALLOWED_DURATIONS=5,15,30,60
MAX_OPEN_TRADES=5
PRICE_DECIMALS=2

# --- price engine ----------------------------------------------------------
SYMBOL=ASIA50
SYMBOL_NAME=ASIA COMPOSITE INDEX
INITIAL_PRICE=6204.5
FEED_ADAPTER=simulated
FEED_MOOD=normal
FEED_MOOD_AUTO=true
FEED_VOLATILITY=1
TICK_INTERVAL_MS=100
TICK_JITTER=true
TICK_SIZE=0.1
TICK_BUFFER_SIZE=20000

# --- retention -------------------------------------------------------------
CANDLE_RETENTION_SEC=172800
AUDIT_RETENTION_SEC=2592000

# --- realtime --------------------------------------------------------------
WS_TICK_MAX_PER_SEC=15
WS_HEARTBEAT_MS=30000
WS_MAX_SUBSCRIPTIONS=20
